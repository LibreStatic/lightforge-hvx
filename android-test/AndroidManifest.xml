<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.librestatic.lfhvxtest"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36" />

    <application
        android:label="lfhvx test"
        android:extractNativeLibs="true"
        android:debuggable="false">
        <!-- Public vendor library (/vendor/etc/public.libraries.txt): must be
             declared so the app's linker namespace can dlopen it (SDK 31+). -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
